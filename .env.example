APP_NAME="ASCOT DRRMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ----------------------------------------------------------------------------
# Database: Supabase (PostgreSQL).
# Supabase dashboard > Connect > Connection string > "Session pooler" (works on
# IPv4 and keeps prepared statements working). Put your database password in
# it. Example:
#   postgresql://postgres.abcdefghij:YOUR-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# The tests never use this: they run on an in-memory SQLite (phpunit.xml).
# ----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_URL=
DB_SSLMODE=require

# Supabase > Project Settings > API Keys. The anon (publishable) key is safe in
# the browser (Realtime only: every table is locked down, see
# App\Support\Supabase\LockDown). The service (secret) key never leaves the server.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Uploaded files (photos, attachments, proof files): "s3" = Supabase Storage,
# "records" = this server's private folder (storage/app/private).
FILES_DISK=records
# Supabase > Storage > S3 Configuration; bucket "drrms", Public OFF.
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=ap-southeast-1
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_BUCKET=drrms

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Jobs (e-mails, SMS, push) wait in Supabase until "php artisan queue:work" sends them.
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ----------------------------------------------------------------------------
# E-mail: Gmail with an App Password (Google Account > Security > 2-Step
# Verification > App passwords; a normal Gmail password does not work).
# MAIL_MAILER=log writes e-mails to storage/logs/laravel.log instead.
# This Laravel uses MAIL_SCHEME ("smtp" = STARTTLS on port 587).
# ----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# SMS: "semaphore" (Philippines) or "log" (write to the log instead of texting).
SMS_GATEWAY=log
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=
# Optional PHP price per SMS segment from your provider agreement (blank = no cost estimate).
SMS_PRICE_PER_SEGMENT=

# Web Push (phone notifications, no Firebase): generate once with
#   php artisan webpush:vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:drrmo@ascot.edu.ph

# Data Privacy Password — a second, system-wide secret required (separately
# from any DRRMO Admin login) before Download Backup, Restore or Clear All
# Records can run. Store only a bcrypt HASH here, never the raw password:
#   php -r "echo password_hash('yourpassword', PASSWORD_BCRYPT);"
# Leaving this unset turns those three off.
DATA_PRIVACY_PASSWORD_HASH=

VITE_APP_NAME="${APP_NAME}"
VITE_SUPABASE_URL="${SUPABASE_URL}"
VITE_SUPABASE_ANON_KEY="${SUPABASE_ANON_KEY}"

# Automatic snapshots (php artisan backup:snapshot): leave empty to turn them off.
# A folder outside the project and outside the web root.
BACKUP_SNAPSHOT_DIR=
# Optional second copy with PostgreSQL's own tool, e.g. C:\pgsql\bin\pg_dump.exe
BACKUP_PG_DUMP=
# Largest file this server can write. The Clear All Records screen warns at 90% of it.
BACKUP_MAX_FILE_BYTES=10485760

# Place search in the "Pick on map" dialog (OpenStreetMap Nominatim, via this server).
# MAP_SEARCH_CONTACT goes in the User-Agent so OSMF can reach whoever runs the server.
# Set MAP_SEARCH_ENABLED=false to switch search off (e.g. if OSMF asks).
MAP_SEARCH_ENABLED=true
MAP_SEARCH_CONTACT=
