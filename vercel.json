{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "version": 2,
    "framework": null,
    "installCommand": "npm ci",
    "buildCommand": "npm run build",
    "outputDirectory": "public",
    "regions": ["sin1"],
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.9.0",
            "maxDuration": 60,
            "excludeFiles": "{node_modules/**,tests/**,docs/**,.git/**,.env*,storage/logs/**,storage/framework/**,database/*.sqlite,resources/demo/**}"
        }
    },
    "routes": [
        { "src": "/(?:index\\.php|.*\\.php|\\..*)(?:/.*)?$", "status": 404 },
        { "handle": "filesystem" },
        { "src": "/(.*)", "dest": "/api/index.php" }
    ],
    "crons": [
        { "path": "/internal/maintenance", "schedule": "0 18 * * *" }
    ]
}
