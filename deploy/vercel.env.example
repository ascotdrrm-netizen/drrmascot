# Add these values to Vercel > Project Settings > Environment Variables.
# This is a template, not an actual credential file. Do not deploy placeholders.
APP_NAME="ASCOT DRRMS"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://YOUR-PROJECT.vercel.app
SERVERLESS_HOSTING=true
DIRECT_UPLOADS=true
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
# Copy the Session pooler URL (port 5432) from Supabase > Connect.
# Percent-encode special characters in the database password.
DB_URL=
DB_SSLMODE=require

FILES_DISK=s3
BACKUP_DISK=s3
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=ap-southeast-1
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_BUCKET=drrms

SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=120

# At least 32 random characters. Vercel adds Authorization: Bearer automatically.
CRON_SECRET=

# Configure a real SMTP provider before inviting Reporters. log sends no email.
MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TIMEOUT=20
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="ASCOT DRRMS"

# Demo only. Real SMS needs a funded provider; log cannot verify phone numbers.
SMS_GATEWAY=log
SEMAPHORE_API_KEY=
DATA_PRIVACY_PASSWORD_HASH=
BACKUP_SNAPSHOT_DIR=
